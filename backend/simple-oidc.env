# Ultra-simplified OIDC environment variables

# OIDC Provider Configuration
OIDC_DOMAIN=http://localhost:8089/realms/demo
OIDC_CLIENT_ID=onyx
OIDC_CLIENT_SECRET=I4QO6ZoA0DNoTHni8sdpeb5WImZEtEhv
OIDC_WELL_KNOWN_URL=http://localhost:8089/realms/demo/.well-known/openid-configuration

# Simple Group Mapping (comma-separated list of admin groups)
OIDC_ADMIN_GROUPS=Onyx-Admins,Administrators,Admin-Users

# Authentication Type
AUTH_TYPE=oidc

# That's it! No complex permission mapping needed.
